<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    PepperDash.ZoomRoom.Sdk sandbox builds are published to the repository owner's GitHub Packages
    feed by the zoom-room-sdk-lib fork's CI. The build workflow authenticates the GitHub source with
    PACKAGES_PAT (falls back to GITHUB_TOKEN); everything else still resolves from nuget.org.
    Package source mapping keeps every other dependency off the authenticated feed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-packages" value="https://nuget.pkg.github.com/beincourt-engineering/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-packages">
      <package pattern="PepperDash.ZoomRoom.Sdk" />
    </packageSource>
  </packageSourceMapping>
</configuration>
